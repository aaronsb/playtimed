[Unit]
Description=Screen time daemon with personality
After=network.target

[Service]
Type=simple
ExecStart=/opt/playtimed/venv/bin/python -m playtimed.main run -c /etc/playtimed/config.yaml
Restart=always
RestartSec=10
Environment=PYTHONPATH=/opt/playtimed/src

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/playtimed
# Browser managed-policy directories (ADR-003). ProtectSystem=strict makes all
# of /etc read-only, so without these the daemon's policy writes fail EROFS and
# the generated rules silently stop tracking the database. The '-' prefix means
# a path that does not exist is not an error, so an absent browser is fine.
ReadWritePaths=-/etc/opt/chrome
ReadWritePaths=-/etc/opt/edge
ReadWritePaths=-/etc/chromium
ReadWritePaths=-/etc/brave
ReadWritePaths=-/etc/firefox
PrivateTmp=true
NoNewPrivileges=false
# Kill user processes, switch users for notifications, and read the user's
# home and runtime directories. Those are 0700, and without CAP_DAC_READ_SEARCH
# root cannot enter them: browser session files and the KWin session bus go
# unread, so no tab is ever seen and browser allowances are never charged.
CapabilityBoundingSet=CAP_KILL CAP_SYS_PTRACE CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
